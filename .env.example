# Copy to .env and fill in. .env is gitignored: never commit real keys.

# Telegram bot (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Nightly planner: DeepSeek by default
DEEPSEEK_API_KEY=
# PLANNER_PROVIDER=anthropic     # use Claude for the planner too (needs ANTHROPIC_API_KEY)
# PLANNER_THINKING=off

# Weekly review: Claude by default
ANTHROPIC_API_KEY=
# REVIEWER_PROVIDER=deepseek     # no Anthropic credit yet? review with DeepSeek instead
# REVIEWER_MODEL=claude-sonnet-5-5
